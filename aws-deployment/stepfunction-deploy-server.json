{
  "Comment": "OSRM deploy server pipeline - deploys a server without building data",
  "StartAt": "DeployServer",
  "States": {
    "DeployServer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "osrm-deploy-server",
        "Payload": {
          "router_region.$": "$.router_region"
        }
      },
      "ResultPath": "$.deploy_result",
      "ResultSelector": {
        "instance_id.$": "$.Payload.instance_id",
        "router_region.$": "$.Payload.router_region"
      },
      "Next": "RegisterInstance"
    },
    "RegisterInstance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "osrm-register-instance",
        "Payload": {
          "instance_id.$": "$.deploy_result.instance_id",
          "target_group_name.$": "$.target_group_name"
        }
      },
      "ResultPath": "$.register_result",
      "Next": "CheckInstanceHealth"
    },
    "CheckInstanceHealth": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "osrm-check-instance-health",
        "Payload": {
          "instance_id.$": "$.deploy_result.instance_id",
          "target_group_name.$": "$.target_group_name"
        }
      },
      "ResultPath": "$.health_check",
      "ResultSelector": {
        "status.$": "$.Payload.status",
        "instance_id.$": "$.Payload.instance_id"
      },
      "Next": "IsHealthy"
    },
    "IsHealthy": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.health_check.status",
          "StringEquals": "healthy",
          "Next": "SwapInstances"
        }
      ],
      "Default": "WaitForHealth"
    },
    "WaitForHealth": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "CheckInstanceHealth"
    },
    "SwapInstances": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "osrm-swap-instances",
        "Payload": {
          "instance_id.$": "$.deploy_result.instance_id",
          "target_group_name.$": "$.target_group_name"
        }
      },
      "End": true
    }
  }
}

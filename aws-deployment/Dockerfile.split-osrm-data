# OSRM AWS Batch Dockerfile
# Optimized for compilation and batch processing on AWS Batch

FROM debian:bookworm-slim AS production

# Install runtime dependencies and AWS CLI
RUN apt-get update && \
    apt-get install -y \
        awscli \
        osmosis \
        wget && \
    rm -rf /var/lib/apt/lists/* && \
    ldconfig /usr/local/lib

# Create working directories
RUN mkdir -p /data /output /logs /config

ENV MALLOC_MMAP_THRESHOLD_=1048576
ENV MALLOC_TRIM_THRESHOLD_=134217728

# Copy source code
COPY . /src
WORKDIR /src

RUN chmod +x ./aws-deployment/*.sh


# Default to the batch entrypoint
ENTRYPOINT ["./aws-deployment/Dockerfile.split-osrm-data.entrypoint.sh"]

# Add labels for better container management
LABEL maintainer="OSRM split utility"
LABEL version="1.0"
LABEL description="Splits .osm.pbf files according to slices"
LABEL org.opencontainers.image.source="https://github.com/bjtaylor1/osrm-backend"

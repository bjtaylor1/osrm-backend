# OSRM Split Testing Dockerfile
# Lightweight image for testing OSM planet file splitting without full OSRM processing
FROM debian:bookworm-slim

# Install only the tools needed for splitting
RUN apt-get update && \
    apt-get install -y \
        awscli \
        ca-certificates \
        osmosis && \
    rm -rf /var/lib/apt/lists/*

# Create working directories
RUN mkdir -p /data /output /logs /config

# Note: planet-latest.osm.pbf should be mounted at runtime with:
# docker run -v /Users/bentaylor/planet-latest.osm.pbf:/data/planet-latest.osm.pbf ...

COPY . /src

# Make scripts executable
RUN chmod +x ./aws-deployment/*.sh

# Set working directory
WORKDIR /src

# Default entrypoint
ENTRYPOINT ["./aws-deployment/Dockerfile.test-planet-split.entrypoint.sh"]

# OSRM Split Testing Dockerfile
# Lightweight image for testing OSM planet file splitting without full OSRM processing
FROM debian:bookworm-slim

# Install only the tools needed for splitting
RUN apt-get update && \
    apt-get install -y \
        awscli \
        ca-certificates \
        osmosis && \
    rm -rf /var/lib/apt/lists/*

# Create working directories
RUN mkdir -p /data /output /scripts /logs /config

# Set up environment variables
ENV OSRM_DATA_DIR=/data
ENV OSRM_LOG_DIR=/logs

# Copy poly files and scripts
COPY config/*.poly /config/
COPY scripts/split-osm.sh /scripts/
COPY Dockerfile.test-planet-split.entrypoint.sh /scripts/

# Make scripts executable
RUN chmod +x /scripts/*.sh

# Set working directory
WORKDIR /data

# Default entrypoint
ENTRYPOINT ["/scripts/Dockerfile.test-planet-split.entrypoint.sh"]

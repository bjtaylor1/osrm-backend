{
  "jobName": "split-planet-data",
  "jobQueue": "job-queue-i3-large",
  "jobDefinition": "osrm-split-job",
  "containerOverrides": {
    "environment": [
      {"name": "OSM_SOURCE", "value": "https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf" },
      {"name": "OSM_FILE", "value": "planet-latest"},
      {"name": "JAVACMD_OPTIONS", "value": "-Xmx50G -server"}
    ]
  }
}
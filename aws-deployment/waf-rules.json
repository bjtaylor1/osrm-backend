{
  "Name": "RouterLoadBalancerWAF",
  "Scope": "REGIONAL",
  "DefaultAction": {
    "Allow": {}
  },
  "Rules": [
    {
      "Name": "BlockIPSet",
      "Priority": 0,
      "Statement": {
        "IPSetReferenceStatement": {
          "Arn": "IP_SET_ARN_PLACEHOLDER"
        }
      },
      "Action": {
        "Block": {}
      },
      "VisibilityConfig": {
        "SampledRequestsEnabled": true,
        "CloudWatchMetricsEnabled": true,
        "MetricName": "BlockIPSet"
      }
    },
    {
      "Name": "BlockDirectIPAccess",
      "Priority": 1,
      "Statement": {
        "NotStatement": {
          "Statement": {
            "OrStatement": {
              "Statements": [
                {
                  "ByteMatchStatement": {
                    "FieldToMatch": {
                      "SingleHeader": {
                        "Name": "host"
                      }
                    },
                    "TextTransformations": [
                      {
                        "Priority": 0,
                        "Type": "LOWERCASE"
                      }
                    ],
                    "PositionalConstraint": "EXACTLY",
                    "SearchString": "router3.gpxplanner.app"
                  }
                },
                {
                  "ByteMatchStatement": {
                    "FieldToMatch": {
                      "SingleHeader": {
                        "Name": "host"
                      }
                    },
                    "TextTransformations": [
                      {
                        "Priority": 0,
                        "Type": "LOWERCASE"
                      }
                    ],
                    "PositionalConstraint": "EXACTLY",
                    "SearchString": "gpxplanner.app"
                  }
                },
                {
                  "ByteMatchStatement": {
                    "FieldToMatch": {
                      "SingleHeader": {
                        "Name": "host"
                      }
                    },
                    "TextTransformations": [
                      {
                        "Priority": 0,
                        "Type": "LOWERCASE"
                      }
                    ],
                    "PositionalConstraint": "EXACTLY",
                    "SearchString": "www.gpxeditor.co.uk"
                  }
                },
                {
                  "ByteMatchStatement": {
                    "FieldToMatch": {
                      "SingleHeader": {
                        "Name": "host"
                      }
                    },
                    "TextTransformations": [
                      {
                        "Priority": 0,
                        "Type": "LOWERCASE"
                      }
                    ],
                    "PositionalConstraint": "EXACTLY",
                    "SearchString": "gpxeditor.co.uk"
                  }
                }
              ]
            }
          }
        }
      },
      "Action": {
        "Block": {}
      },
      "VisibilityConfig": {
        "SampledRequestsEnabled": true,
        "CloudWatchMetricsEnabled": true,
        "MetricName": "BlockDirectIPAccess"
      }
    },
    {
      "Name": "BlockScanners",
      "Priority": 2,
      "Statement": {
        "ByteMatchStatement": {
          "FieldToMatch": {
            "SingleHeader": {
              "Name": "user-agent"
            }
          },
          "TextTransformations": [
            {
              "Priority": 0,
              "Type": "LOWERCASE"
            }
          ],
          "PositionalConstraint": "CONTAINS",
          "SearchString": "scan"
        }
      },
      "Action": {
        "Block": {}
      },
      "VisibilityConfig": {
        "SampledRequestsEnabled": true,
        "CloudWatchMetricsEnabled": true,
        "MetricName": "BlockScanners"
      }
    },
    {
      "Name": "RateLimit",
      "Priority": 3,
      "Statement": {
        "RateBasedStatement": {
          "Limit": 2000,
          "AggregateKeyType": "IP"
        }
      },
      "Action": {
        "Block": {}
      },
      "VisibilityConfig": {
        "SampledRequestsEnabled": true,
        "CloudWatchMetricsEnabled": true,
        "MetricName": "RateLimit"
      }
    }
  ],
  "VisibilityConfig": {
    "SampledRequestsEnabled": true,
    "CloudWatchMetricsEnabled": true,
    "MetricName": "RouterLoadBalancerWAF"
  }
}
